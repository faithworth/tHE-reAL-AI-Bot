# AI EA v20 — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ═══════════════════════════════════════════════════════════════════════════════
# BROKER SELECTION — uncomment the section for your broker
# ═══════════════════════════════════════════════════════════════════════════════

# ── Option 1: Alpaca (stocks + crypto, paper or live) ────────────────────────
#BROKER_TYPE=alpaca
# Get keys at: https://alpaca.markets → Account → API Keys
#ALPACA_API_KEY=your_alpaca_api_key_here
#ALPACA_SECRET_KEY=your_alpaca_secret_key_here
#ALPACA_PAPER=true               # true=paper trading (free,safe); false=live real money
#ALPACA_DATA_FEED=iex            # iex=free real-time data; sip=paid (faster, more accurate)
#ALPACA_OFFLINE=false            # true=100% offline simulation, zero API calls (offline mode)

# Symbols for Alpaca (stocks + crypto)
#SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,BTC/USD,ETH/USD

# ── Option 2: MT5 (forex, gold, indices) ─────────────────────────────────────
BROKER_TYPE=mt5
MT5_LOGIN=5168814
MT5_PASSWORD=23VYTy^y2n
MT5_SERVER=GTioMarketsPty-Demo
SYMBOLS=XAUUSD..,BTCUSD..,US100..,US30..,US500..,XAGUSD..,EURUSD..,GBPUSD..,USDJPY..,AUDUSD..,USDCHF..,NZDUSD..,EURGBP..,EURJPY..,GBPJPY..,AUDJPY..,CHFJPY..

# ── Option 3: Interactive Brokers ────────────────────────────────────────────
#BROKER_TYPE=ibkr
#IBKR_HOST=127.0.0.1
#IBKR_PORT=7497
#IBKR_CLIENT_ID=1
#IBKR_ACCOUNT=
#IBKR_PAPER=true
#SYMBOLS=EUR.USD,XAU.USD,SPX

# ── Option 4: cTrader ────────────────────────────────────────────────────────
#BROKER_TYPE=ctrader
#CTRADER_CLIENT_ID=your_client_id
#CTRADER_CLIENT_SECRET=your_client_secret
#CTRADER_ACCESS_TOKEN=your_access_token
#CTRADER_ACCOUNT_ID=0
#CTRADER_DEMO=true

# ═══════════════════════════════════════════════════════════════════════════════
# TRADING SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════
LOT_SIZE=0.01
MAX_POSITIONS_SYMBOL=2
SLEEP_INTERVAL=300              # seconds between cycles (300 = 5 min)
BARS=8160                       # H1 bars for ML training (~3 months)

# ═══════════════════════════════════════════════════════════════════════════════
# RISK SETTINGS
# ───────────────────────────────────────────────────────────────────────────────
# Leave at 0 to let the EA auto-select the right tier for your account size.
# All limits are expressed as % of your equity — currency-neutral.
#
#   Tier        Risk/trade  Daily limit  Max DD   Concurrent  Trades/day
#   < 500       1.2%        4.5%         12%      3           8
#   500-1000    1.0%        4.0%         10%      3           8
#   1000-3000   0.8%        3.5%         9%       4           10
#   3000-10000  0.7%        3.0%         8%       4           10
#   10000-30000 0.6%        2.8%         8%       5           12
#   30000-100k  0.5%        2.5%         7%       6           15
#   100k+       0.4%        2.0%         6%       8           20
#
# Set non-zero ONLY to override the auto-tier (not recommended):
RISK_PER_TRADE=0
MAX_DAILY_LOSS=0
MAX_DRAWDOWN=0
MAX_TRADES_DAY=0
MAX_CONCURRENT=0
ATR_MULTIPLIER=1.5

# ═══════════════════════════════════════════════════════════════════════════════
# SIGNAL QUALITY
# ═══════════════════════════════════════════════════════════════════════════════
PROP_MODE=false
MIN_SIGNAL_PROB=0.38            # v20: raised slightly for better win precision

# ═══════════════════════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════════
# ADVANCED (usually leave as-is)
# ═══════════════════════════════════════════════════════════════════════════════
MAX_GROUP_RISK_PCT=0.06
# CORR_GROUPS=[["AAPL","MSFT","NVDA"],["BTC/USD","ETH/USD"]]
